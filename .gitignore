.pytest_cache/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.ipynb_checkpoints/

# --- Model weights / checkpoints ---
ckpt/
wan_models/
*.pt
*.pth
*.safetensors
*.ckpt
*.bin

# --- Generated media / outputs ---
videos/
*.mp4

# --- Environments / editors / OS ---
.venv/
venv/
.env
.vscode/
.idea/
.DS_Store

.claude/

# --- Figures/plots and other unecessary files ---
# reference/ contient a la fois des ARTEFACTS lourds (videos, planches, poids, dumps) et le
# CODE + les NOTES du projet (registre d'experiences, scripts de sondage, campagnes, plans).
# On exclut tout par defaut, puis on re-inclut explicitement le code et les documents.
reference/**
!reference/**/
!reference/**/*.py
!reference/**/*.sh
!reference/**/*.md
!reference/**/*.yaml
!reference/**/*.yml
!reference/**/*.txt
# les artefacts lourds restent exclus meme s'ils portent une extension re-incluse
reference/**/*.jpg
reference/**/*.jpeg
reference/**/*.png
reference/**/*.mp4
reference/**/*.pt
reference/**/*.npz
reference/**/*.safetensors

# --- wandb local cache ---
wandb/

# --- debug log---
tea_debug.log
